{
	"name": "pl_ingest_velib",
	"properties": {
		"description": "Copies the Vélib' GBFS feeds to bronze/velib/<feed>/yyyy/MM/dd/HH/mm.json (same layout as velib.bronze_path).",
		"activities": [
			{
				"name": "ForEachFeed",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.feeds",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "LookupFeed",
							"description": "Reads the feed to check it before copying it (same rules as velib.validate_payload).",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"dataset": {
									"referenceName": "ds_velib_feed",
									"type": "DatasetReference",
									"parameters": {
										"feed": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "IfFeedIsValid",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "LookupFeed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(length(coalesce(activity('LookupFeed').output?.firstRow?.data?.stations, json('[]'))), 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "FailInvalidFeed",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('Invalid Velib payload for feed ', item(), ': no stations in data.stations')",
												"type": "Expression"
											},
											"errorCode": "INVALID_PAYLOAD"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "CopyFeedToBronze",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.00:05:00",
											"retry": 3,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "JsonSource",
												"storeSettings": {
													"type": "HttpReadSettings",
													"requestMethod": "GET"
												},
												"formatSettings": {
													"type": "JsonReadSettings"
												}
											},
											"sink": {
												"type": "JsonSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "JsonWriteSettings"
												}
											},
											"enableStaging": false,
											"dataIntegrationUnits": 2
										},
										"inputs": [
											{
												"referenceName": "ds_velib_feed",
												"type": "DatasetReference",
												"parameters": {
													"feed": {
														"value": "@item()",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_bronze_json",
												"type": "DatasetReference",
												"parameters": {
													"folderPath": {
														"value": "@concat('velib/', item(), '/', formatDateTime(pipeline().TriggerTime, 'yyyy/MM/dd/HH'))",
														"type": "Expression"
													},
													"fileName": {
														"value": "@concat(formatDateTime(pipeline().TriggerTime, 'mm'), '.json')",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "FailIngestion",
				"description": "Explicit failure so the run shows up as failed in Monitor and triggers the alert.",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "ForEachFeed",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@concat('Velib ingestion failed at ', string(pipeline().TriggerTime), ': ', coalesce(activity('ForEachFeed').error?.message, 'see inner activity errors'))",
						"type": "Expression"
					},
					"errorCode": "INGESTION_FAILED"
				}
			},
			{
				"name": "RunProcessingNotebook",
				"description": "bronze -> silver -> gold, right after the ingestion (EF1.6).",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "ForEachFeed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": {
							"value": "nb_velib_processing",
							"type": "Expression"
						},
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": {
							"value": "sparkvelib",
							"type": "Expression"
						},
						"type": "BigDataPoolReference"
					},
					"conf": {
						"spark.dynamicAllocation.enabled": null,
						"spark.dynamicAllocation.minExecutors": null,
						"spark.dynamicAllocation.maxExecutors": null
					},
					"numExecutors": null
				},
				"linkedServiceName": {
					"referenceName": "ls_synapse_velib",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"feeds": {
				"type": "array",
				"defaultValue": [
					"station_status",
					"station_information"
				]
			}
		},
		"annotations": []
	}
}